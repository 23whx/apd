# Copy to .env.publish.local (git-ignored) and fill in. Used only by scripts/publish-article.mjs.
# The service_role key bypasses row-level security: keep it on this machine, never in frontend code.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: author users.id (default: the first admin user)
PUBLISH_AUTHOR_ID=
# Optional: Vercel deploy hook URL, triggers a rebuild (sitemap + prerendered HTML) after publishing
VERCEL_DEPLOY_HOOK_URL=
